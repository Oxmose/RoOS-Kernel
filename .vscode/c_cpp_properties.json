{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/**",
                "Source/**",
                "Source/Kernel/libs/libc/includes/**"
            ],
            "defines": [
                "_TESTING_FRAMEWORK_ENABLED",
                "SOC_MAX_CPU_COUNT=64",
                "ssize_t=long long int"
            ],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "c11",
            "cppStandard": "c++98",
            "intelliSenseMode": "linux-gcc-x64"
        }
    ],
    "version": 4
}